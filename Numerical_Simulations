def make_threshold_event(pmin):
    """
    Event corresponding to a downward crossing of p_min.
    """
    def event(t, y):
        return y[0] - pmin

    event.terminal = True
    event.direction = -1

    return event


def periodicity_check(umax, n_impulses=6):
    """
    Computes successive impulse times and compares the
    inter-impulse intervals with T = 2*pi.
    """

    pars = periodic_parameters(umax)

    pmin = pars["p_min"]
    alpha = pars["alpha"]
    p0 = pars["p0"]

    event = make_threshold_event(pmin)

    current_t = 0.0
    current_y = np.array([p0])

    impulse_times = []

    for k in range(n_impulses):

        sol = solve_ivp(
            dydt,
            (current_t, current_t + 2*T),
            current_y,
            events=event,

            # High-accuracy integration for the periodicity check
            rtol=1e-11,
            atol=1e-13
        )

        if len(sol.t_events[0]) == 0:
            raise RuntimeError(
                f"No threshold crossing detected after impulse {k}."
            )

        # Exact event location returned by solve_ivp
        te = sol.t_events[0][0]
        pe = sol.y_events[0][0][0]

        impulse_times.append(te)

        # Apply the impulse
        current_t = te
        current_y = np.array([pe + alpha])

    impulse_times = np.asarray(impulse_times)

    # Inter-impulse intervals
    intervals = np.diff(impulse_times)

    # Errors relative to T
    interval_errors = np.abs(intervals - T)

    # Theoretical impulse times:
    # t_k = t1 + (k-1)T
    theoretical_times = (
        t1 + np.arange(n_impulses) * T
    )

    time_errors = np.abs(
        impulse_times - theoretical_times
    )

    return (
        pars,
        impulse_times,
        intervals,
        interval_errors,
        theoretical_times,
        time_errors
    )

for umax in umax_values:

    (
        pars,
        impulse_times,
        intervals,
        interval_errors,
        theoretical_times,
        time_errors
    ) = periodicity_check(
        umax,
        n_impulses=6
    )

    print("\n" + "=" * 75)
    print(f"u_max = {umax:g}")

def c(t):
    return 0.5 + 0.1 * np.sin(t)

def e(t):
    return 0.7 + 0.1 * np.cos(t)

def d(t):
    return e(t) - c(t)

def h(t):
    return -c(t)/d(t)


def compute_exp_integral_d_0_T(T, d_fun):
    integral_d_0_T, _ = quad(d_fun, 0, T)
    return np.exp(integral_d_0_T)

def Psi(t, T, c_fun, d_fun, factor_exp_0_T):
    # First term
    def integrand_1(s):
        integral_d_t_s, _ = quad(d_fun, t, s)
        return c_fun(s) * np.exp(-integral_d_t_s)
    integral_1, _ = quad(integrand_1, t, T)
    term1 = integral_1 * factor_exp_0_T
    # Second term
    def integrand_2(s):
        integral_d_s_t, _ = quad(d_fun, s, t)
        return c_fun(s) * np.exp(integral_d_s_t)
    term2, _ = quad(integrand_2, 0, t)
    return term1 + term2

def compute_u0(t1, T, c_fun, d_fun, u_alpha):
    integral_d_t1_T, _ = quad(d_fun, t1, T)
    term1 = u_alpha * np.exp(integral_d_t1_T)
    def integrand(s):
        integral_d_s_T, _ = quad(d_fun, s, T)
        return c_fun(s) * np.exp(integral_d_s_T)
    term2, _ = quad(integrand, t1, T)
    return term1 + term2


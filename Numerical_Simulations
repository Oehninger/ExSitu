# Period and first impulse time
T = 2 * np.pi
t1 = 1.0

# Values selected for the numerical examples
umax_values = [12.0, 15.0, 20.0]


def periodic_parameters(umax):
    """
    Computes the parameters defining the periodic solution
    according to Theorem 2.
    """

    # exp(int_0^T d(s) ds)
    factor_exp_0_T = compute_exp_integral_d_0_T(T, d)

    # Psi(t1)
    psi_t1 = Psi(
        t=t1,
        T=T,
        c_fun=c,
        d_fun=d,
        factor_exp_0_T=factor_exp_0_T
    )

    # u_alpha
    u_alpha = (umax - psi_t1) / factor_exp_0_T

    # minimum viable threshold
    pmin = 1.0 / umax

    # impulse magnitude
    alpha = 1.0 / u_alpha - pmin

    # u(0)
    u0 = compute_u0(
        t1=t1,
        T=T,
        c_fun=c,
        d_fun=d,
        u_alpha=u_alpha
    )

    # corresponding initial condition
    p0 = 1.0 / u0

    return {
        "u_max": umax,
        "Psi(t1)": psi_t1,
        "u_alpha": u_alpha,
        "p_min": pmin,
        "alpha": alpha,
        "u0": u0,
        "p0": p0
    }



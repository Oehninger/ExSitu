## Figure 7

def c(t):
    return 0.5 + 0.2 * np.sin(t)

def e(t):
    return 0.6 + 0.1 * np.cos(t)


alpha = 0.3                     
y0_list = [0.2, 0.35, 0.5, 0.65]
pmin = 0.18
t_end = 50.0


impulse_families = [
    list(range(3, 51, 3)),    
    list(range(2, 51, 2)),    
    list(range(1, 51, 1))     
]


def K(y, alpha):
    if y < pmin:
        return 0.0
    else:
        return alpha * (1.0 - y) / (2.0 - (y + pmin))


def f(t, y):
    
    return c(t) * y * (1.0 - y) - e(t) * y


fig, axes = plt.subplots(nrows=3, ncols=1, figsize=(8, 10), sharex=True)

for idx, impulse_times in enumerate(impulse_families):
    ax = axes[idx]

    for y0 in y0_list:
        t_parts, y_parts = [], []
        current_t = 0.0
        current_y = float(y0)

        
        for t_impulse in impulse_times:
            if t_impulse <= current_t:
                continue
            if t_impulse > t_end:
                break

            sol = solve_ivp(
                f, (current_t, t_impulse), [current_y],
                t_eval=np.linspace(current_t, t_impulse, 200)
            )
            t_parts.append(sol.t)
            y_parts.append(sol.y[0])

            
            current_t = float(t_impulse)
            y_before = float(sol.y[0, -1])
            current_y = y_before + K(y_before, alpha)

            
            t_parts.append(np.array([current_t]))
            y_parts.append(np.array([current_y]))

        
        if current_t < t_end:
            sol = solve_ivp(
                f, (current_t, t_end), [current_y],
                t_eval=np.linspace(current_t, t_end, 200)
            )
            t_parts.append(sol.t)
            y_parts.append(sol.y[0])

        
        t_total = np.concatenate(t_parts) if len(t_parts) else np.array([0.0])
        y_total = np.concatenate(y_parts) if len(y_parts) else np.array([y0])

        ax.plot(t_total, y_total, label=f'$p(0)={y0}$')

    
    ax.axhline(pmin, color='gray', linestyle='--', linewidth=1, label=r'$p_{\min}=0.18$')
    
    if len(impulse_times) >= 2 and np.allclose(np.diff(impulse_times), np.diff(impulse_times)[0]):
        dt = np.diff(impulse_times)[0]
        ax.set_title(fr'Observation times $\{{{{{dt}}}\, n\}}_{{n}}$ and $\alpha=0.3$')
    else:
        ax.set_title(f'Familia {idx+1}: impulsos en {impulse_times}  (α=0.3)')
    ax.set_ylabel('Fraction of inhabited patches')
    ax.grid(True)
    ax.legend(loc='upper right')

axes[-1].set_xlabel('Time')

plt.tight_layout()
plt.savefig('Figure4_multiy0_familias.eps', format='eps')
plt.show()




